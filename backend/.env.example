# Django Settings
# DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# ALLOWED_HOSTS=*

# Database (optional, defaults to SQLite if not set)
# For PostgreSQL: postgresql://user:CHANGE_ME@localhost:5432/dbname
# DATABASE_URL=postgresql://user:CHANGE_ME@localhost:5432/dbname

# Playwright MCP (browser automation for agents)
# Set to "true" to enable Playwright tools
# PLAYWRIGHT_MCP_ENABLED=true
