{
  "name": "aiworks-cli",
  "version": "1.0.0",
  "type": "module",
  "description": "AiWorks Sample App desktop CLI — establishes a WebSocket tunnel to the cloud for local MCP server access",
  "main": "dist/main.js",
  "bin": {
    "aiworks": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "aiworks-sample-app",
    "desktop",
    "tunnel"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jose": "^5.2.0",
    "minimist": "^1.2.8",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
