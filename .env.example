# Django Settings
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=your-secret-key-here

# Use a separate signing key for JWT tokens (recommended; falls back to DJANGO_SECRET_KEY if not set)
# JWT_SIGNING_KEY=your-jwt-signing-key-here

DEBUG=False

ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# POSTGRES_DB=aiworks_sample
# POSTGRES_USER=aiworks_user
# POSTGRES_PASSWORD=change-me-in-production

# ────────────────────────────────────────────────────────────
# DB Pool — connection pool settings
# Sits between the application and PostgreSQL to limit
# concurrent connections and reduce load on the database.
# Defaults are tuned for LLM agent workloads (long-running queries).
# ────────────────────────────────────────────────────────────

# Maximum connections maintained to PostgreSQL
# DB_POOL_SIZE=80

# Minimum connections kept open when idle
# DB_POOL_MIN=2

# Seconds to wait for a free connection from the pool
# before queuing the client
# DB_POOL_CLIENT_TIMEOUT=30

# Seconds to hold an idle connection open before closing it
# Must exceed your longest query runtime (1 hour for LLM agents)
# DB_POOL_IDLE_TIMEOUT=3600

# Maximum total connections from the application
# DB_POOL_MAX_CLIENT_CONN=80
